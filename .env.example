# Copy this file to .env and replace YOUR_POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/game_catalog
REDIS_URL=redis://localhost:6379/0
TCP_HOST=127.0.0.1
TCP_PORT=8765

# HTTP API session signing secret. Replace with a random local value in .env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-change-me
APP_ENV=development
